# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard → Project Settings → API Keys).

# --- Público (vai para o browser) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...). A chave legada "anon" também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública do site (usada para gerar a URI do .cfg do GSI).
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente servidor (NUNCA prefixar com NEXT_PUBLIC_) -----------------------
# Secret key (sb_secret_...) ou a chave legada "service_role". Ignora RLS.
SUPABASE_SECRET_KEY=
# Senha do painel /admin.
ADMIN_PASSWORD=
